generator client {
  provider = "prisma-client-js"
  output   = "../../generated/property"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_UP_PROPERTY")
}

model tbl_property_master {
  id                            Int                          @id @default(autoincrement())
  ulb_id                        Int
  wardArea_id                   Int
  property_type_id              Int
  road_type_id                  Int
  const_type_id                 Int?
  usage_type_id                 Int
  ownershipType_id              Int
  zone_id                       Int
  ward_id                       Int?
  area_type                     Int?
  saf_type                      String
  saf_fyYear_id                 Int
  saf_fy_Year                   String
  unique_Property_Id            String
  saf_no                        String
  new_holding_no                String?
  primary_contact_no            String
  rain_water_harvest            String?
  plot_area                     Float?
  builtup_ground_floor          Float?
  construction_date             DateTime
  water_conn_type               String?
  water_tax_type                String?
  approval_by                   Int?
  approval_datetime             DateTime?
  approval_status               Int?
  recstatus                     Int                          @default(1)
  status_type                   Int?
  updatedTime                   DateTime?
  update_by                     Int?
  update_ipAddress              String?
  entryDateTime                 DateTime?
  entryBy                       Int?
  entry_ipAddress               String?
  waterPay_status               String?
  lateSubmission_pay_status     String?
  late_submission               String?
  holding_type                  String?
  current_front_property_image  String?
  qr_no                         String?                      @unique
  heliware_no                   String?
  const_age                     Int                          @default(1)
  isGarden                      Boolean                      @default(false)
  created_at                    DateTime                     @default(now())
  update_at                     DateTime                     @default(now()) @updatedAt
  qrTagging                     tbl_qr_tagging?              @relation(fields: [qr_no], references: [qr_no])
  owner                         tbl_property_owner[]
  propertyDetails               tbl_property_details[]
  floorDetails                  tbl_property_floor[]
  propertyDemand                tbl_property_demand[]
  geoTagging                    tbl_geoTagging[]
  propertyDocument              tbl_property_document[]
  propertyDocVerification       tbl_property_doc_verification[]
  propertyDeactivate            tbl_property_deactivate[]
  propertyPenalty               tbl_property_penalty[]
  safArvDetails                 tbl_saf_arv_details[]
  propertyOwnerTax              tbl_property_owner_tax[]
  transactionMaster             tbl_transaction_master[]
  transactionDetails            tbl_transaction_details[]
  propertyTransactionAdvance    tbl_property_advance[]
  propertyTransactionDeactivate tbl_transaction_deactivate[]
  ownerDocument                 tbl_owner_document[]
  collectionDetails             tbl_collection_details[]
}

model tbl_qr_tagging {
  id             Int                  @id @default(autoincrement())
  qr_no          String               @unique
  document       String
  recstatus      Int                  @default(1)
  entryBy        Int?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt
  propertyMaster tbl_property_master?
}

model tbl_property_owner {
  id                 Int                  @id @default(autoincrement())
  propertyMaster_id  Int
  honorific          String?
  owner_name         String
  gender             String
  guardian_name      String?
  relation           String?
  contact_no         String
  pan_no             String?
  owner_photo_doc    String?
  effective_from     DateTime @default(now())
  effective_to       DateTime?
  is_current         Boolean  @default(true)
  recStatus          Int                  @default(1)
  updatedBy          String?
  updateIpAddress    String?
  entryBy            Int
  entryIpAddress     String?
  owner_id_proof_doc String?
  owner_image        String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now()) @updatedAt
  propertyMaster     tbl_property_master  @relation(fields: [propertyMaster_id], references: [id])
  ownerDocument      tbl_owner_document[]
}

model tbl_owner_document {
  id                 Int                 @id @default(autoincrement())
  owner_id           Int
  property_master_id Int
  document_id        Int
  reciept_filename   String
  path_name          String
  recstatus          Int                 @default(1)
  entryBy            Int
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  propertyMaster     tbl_property_master @relation(fields: [property_master_id], references: [id])
  owner              tbl_property_owner  @relation(fields: [owner_id], references: [id])
}

model tbl_property_details {
  id                     Int                 @id @default(autoincrement())
  propertyMaster_id      Int                 @unique
  prim_houseNo           String?
  prim_mohalla           String
  prim_address           String
  prim_pincode           String
  corres_houseNo         String?
  corres_mohalla         String
  corres_address         String
  corres_pincode         String
  phone_no               String
  email_id               String?
  khata_no               String?
  plot_no                String?
  mauja_name             String?
  old_ward_no            String?
  old_holding_no         String?
  old_unique_property_id String?
  rain_water_harvest_doc String?
  entry_by               Int?
  entry_IpAddress        String?
  building_name          String?
  thana_no               String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now()) @updatedAt
  propertyMaster         tbl_property_master @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_property_floor {
  id                   Int                 @id @default(autoincrement())
  propertyMaster_id    Int
  floorType_name       String
  usageType_name       String
  usgaeFactor_name     String
  occupancyType_name   String
  constType_name       String
  builtup_area         Float?
  room_veranda_area    Float?
  balcony_kitchen_area Float?
  sub_usage_type       Int?
  garage_area          Float?
  assess_from          DateTime?
  assess_upto          DateTime?
  assess_from_year     String
  assess_upto_year     String
  saf_fy_year_id       Int
  saf_fy_year          String
  recstatus            Int                 @default(1)
  updateBy             String?
  update_IpAddress     String?
  entryBy              Int?
  entry_IpAddress      String?
  floor_type_id        Int
  usage_type_id        Int
  usage_factor_id      Int
  occupancy_type_id    Int
  construction_id      Int
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now()) @updatedAt
  propertyMaster       tbl_property_master @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_geoTagging {
  id                Int                 @id @default(autoincrement())
  propertyMaster_id Int
  latitude          String?
  longitude         String?
  document_id       Int
  reciept_filename  String
  path_name         String
  recstatus         Int                 @default(1)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now()) @updatedAt
  propertyMaster    tbl_property_master @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_property_demand {
  id                Int                      @id @default(autoincrement())
  propertyMaster_id Int
  ulb_id            Int?
  zone_id           Int?
  ward_id           Int?
  wardArea_id       Int
  saf_fy_year_id    BigInt
  saf_fy_year       String
  demand_fy_year    String?
  demand_fy_year_id Int?
  ward_rate         Float
  arv_rate          Float
  carpetArv_rate    Float
  const_age         Int
  constAge_tax      Float
  house_tax         Float
  water_tax         Float
  waste_tax         Float
  total_tax         Float
  balance_amount    Float?
  garden_rebate     Float                    @default(0)
  part_house_tax    Float                    @default(0)
  part_water_tax    Float                    @default(0)
  part_waste_tax    Float                    @default(0)
  part_total_tax    Float                    @default(0)
  late_submission   Float?
  paid_status       Int                      @default(0)
  recstatus         Int                      @default(1)
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @default(now()) @updatedAt
  propertyMaster    tbl_property_master      @relation(fields: [propertyMaster_id], references: [id])
  propertyPenalty   tbl_property_penalty[]
  collectionDetails tbl_collection_details[]
}

model tbl_property_document {
  id                      Int                             @id @default(autoincrement())
  propertyMaster_id       Int
  document_id             Int
  receipt_filename        String
  path_name               String
  recstatus               Int                             @default(1)
  entryBy                 Int
  enrty_ipAddress         String
  created_at              DateTime                        @default(now())
  updated_at              DateTime                        @default(now()) @updatedAt
  propertyMaster          tbl_property_master             @relation(fields: [propertyMaster_id], references: [id])
  propertyDocVerification tbl_property_doc_verification[]
}

model tbl_property_doc_verification {
  id                Int                   @id @default(autoincrement())
  propertyMaster_id Int
  property_doc_id   Int
  recstatus         Int                   @default(1)
  entryBy           Int
  enrty_ipAddress   String
  created_at        DateTime              @default(now())
  updated_at        DateTime              @default(now()) @updatedAt
  is_verified       Boolean               @default(false)
  remarks           String?
  propertyDocument  tbl_property_document @relation(fields: [property_doc_id], references: [id])
  propertyMaster    tbl_property_master   @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_property_penalty {
  id                 Int                 @id @default(autoincrement())
  propDemand_id      Int
  propertyMaster_id  Int
  penalty_amount     Float
  penalty_percentage Int
  fy_id              Int?
  recstatus          Int                 @default(1)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  propertyDemand     tbl_property_demand @relation(fields: [propDemand_id], references: [id])
  propertyMaster     tbl_property_master @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_property_deactivate {
  id                Int                 @id @default(autoincrement())
  ulb_id            Int
  propertyMaster_id Int
  ward_id           Int
  file_name         String
  remarks           String
  recstatus         Int                 @default(1)
  entryBy           Int
  entryIpAddress    String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now()) @updatedAt
  propertyMaster    tbl_property_master @relation(fields: [propertyMaster_id], references: [id])
}

model tbl_saf_arv_details {
  id                  Int                 @id @default(autoincrement())
  property_master_id  Int
  saf_fy_Year         String
  floor_name          String?
  usage_name          String?
  usage_type_factor   String?
  construction_type   String
  occupancy_type      String?
  builtup_area        Float
  ward_rate           Float
  occupancy_rate      Float?
  arv_rate            Float
  property_percentage Float?
  assess_from         DateTime?
  assess_upto         DateTime?
  saf_fy_year_id      Int
  saf_fy_year         String
  yearly_tax          String
  recstatus           Int                 @default(1)
  updateBy            String?
  update_ip_address   String?
  entryBy             Int?
  entry_ip_address    String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @default(now()) @updatedAt
  propertyMaster      tbl_property_master @relation(fields: [property_master_id], references: [id])
}

model tbl_property_owner_tax {
  id                 Int                 @id @default(autoincrement())
  property_master_id Int
  saf_fy_Year        String
  annual_floor_tax   Float?
  annual_vacant_tax  Float?
  annual_total       Float
  saf_fy_year_id     Int
  saf_fy_year        String
  recstatus          Int                 @default(1)
  updateBy           String?
  update_ip_address  String?
  entryBy            Int?
  entry_ip_address   String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  propertyMaster     tbl_property_master @relation(fields: [property_master_id], references: [id])
}

enum TransactionType {
  Part
  Full
}

model tbl_transaction_master {
  id                    Int                          @id @default(autoincrement())
  ulb_id                Int
  zone_id               Int
  ward_id               Int
  property_master_id    Int
  trans_no              String
  trans_date            DateTime
  due_from              String
  due_upto              String
  actual_demand         Float
  penalty               Float
  water_charge          Float
  Type                  TransactionType?
  late_submission       Float?
  rain_water_harvest    String?
  rebate_early          Float?
  total_rebate          Float?
  payable_amount        Float?
  advance               Float
  paid_amount           Float
  remarks               String
  payment_mode          String?
  cancel_status         String?
  cash_verify_status    Int?                         @default(0)
  cash_verify_id        Int?
  verify_date_time      DateTime?
  scheme                String?
  recstatus             Int                          @default(1)
  updateBy              String?
  update_ip_address     String?
  entryBy               Int?
  entry_ip_address      String?
  created_at            DateTime                     @default(now())
  updated_at            DateTime                     @default(now()) @updatedAt
  propertyMaster        tbl_property_master          @relation(fields: [property_master_id], references: [id])
  transactionDetails    tbl_transaction_details[]
  propertyAdvance       tbl_property_advance[]
  transactionDeactivate tbl_transaction_deactivate[]
  collectionDetails     tbl_collection_details[]
}

model tbl_transaction_details {
  id                                 Int                    @id @default(autoincrement())
  property_master_id                 Int
  transaction_id                     Int
  upi_cheque_cardtrans_id_neftref_no String?
  cheque_neft_date                   DateTime?
  branch_name                        String?
  bank_name                          String?
  card_type                          String?
  card_no                            String?
  card_holder_name                   String?
  paid_amount                        Float
  transaction_status                 String?
  reconcile_date                     DateTime?
  remarks                            String?
  upi_cheque_dd_image                String?
  recstatus                          Int                    @default(1)
  updateBy                           String?
  update_ip_address                  String?
  entryBy                            Int?
  entry_ip_address                   String?
  created_at                         DateTime               @default(now())
  updated_at                         DateTime               @default(now()) @updatedAt
  propertyMaster                     tbl_property_master    @relation(fields: [property_master_id], references: [id])
  transactionMaster                  tbl_transaction_master @relation(fields: [transaction_id], references: [id])
}

model tbl_collection_details {
  id                 Int                    @id @default(autoincrement())
  ulb_id             Int
  zone_id            Int
  ward_id            Int
  property_master_id Int
  demand_id          Int
  trans_id           Int
  house_tax          Float
  water_tax          Float
  waste_tax          Float
  total_tax          Float
  saf_fy_year_id     Int
  saf_fy_year        String
  late_submission    Int?
  yearly_demand      Int?
  balance_amount     Int?
  old_ward_id        Int?
  vacant_tax_demand  Int?
  difference_amount  Int?
  entryBy            Int?
  entry_ip_address   String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @default(now()) @updatedAt
  propertyMaster     tbl_property_master    @relation(fields: [property_master_id], references: [id])
  demand             tbl_property_demand    @relation(fields: [demand_id], references: [id])
  transaction        tbl_transaction_master @relation(fields: [trans_id], references: [id])
}

model tbl_property_advance {
  id                 Int                    @id @default(autoincrement())
  ulb_id             Int
  property_master_id Int
  zone_id            Int
  ward_id            Int
  transaction_id     Int
  amount             Float
  balance_amount     Float
  advance_type       String
  file_name          String
  remarks            String
  reason             String
  recstatus          Int                    @default(1)
  updateBy           String?
  update_ip_address  String?
  entryBy            Int?
  entry_ip_address   String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @default(now()) @updatedAt
  propertyMaster     tbl_property_master    @relation(fields: [property_master_id], references: [id])
  transactionMaster  tbl_transaction_master @relation(fields: [transaction_id], references: [id])
}

model tbl_transaction_deactivate {
  id                 Int                    @id @default(autoincrement())
  ulb_id             Int
  ward_id            Int
  property_master_id Int
  transaction_id     Int
  file_name          String?
  remarks            String?
  recstatus          Int                    @default(1)
  updateBy           String?
  update_ip_address  String?
  entryBy            Int?
  entry_ip_address   String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @default(now()) @updatedAt
  propertyMaster     tbl_property_master    @relation(fields: [property_master_id], references: [id])
  transactionMaster  tbl_transaction_master @relation(fields: [transaction_id], references: [id])
}

