generator client {
  provider = "prisma-client-js"
  output   = "../../generated/saf"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_UP_SAF")
}

model tbl_constructionType_master {
  id                    Int                   @id @default(autoincrement())
  ulb_id                Int?
  constructionType_name String
  shortName             String
  recStatus             Int                   @default(1)
  tbl_wardRate_master   tbl_wardRate_master[]
}

model tbl_roadType_master {
  id                  Int                   @id @default(autoincrement())
  ulb_id              Int?
  roadType_name       String
  recStatus           Int                   @default(1)
  tbl_wardRate_master tbl_wardRate_master[]
}

model tbl_propertyType_master {
  id                Int    @id @default(autoincrement())
  ulb_id            Int?
  propertyType_name String
  recStatus         Int    @default(1)
}

model tbl_areaType_master {
  id            Int    @id @default(autoincrement())
  ulb_id        Int?
  areaType_name String
  recStatus     Int    @default(1)
}

model tbl_occupancyType_master {
  id                 Int    @id @default(autoincrement())
  ulb_id             Int?
  occupancyType_name String
  multiplying_factor Float?
  recStatus          Int    @default(1)
}

model tbl_usageType_master {
  id             Int                       @id @default(autoincrement())
  ulb_id         Int?
  usageType_name String
  recStatus      Int                       @default(1)
  subUsageType   tbl_subUsageType_master[]
}

model tbl_subUsageType_master {
  id                Int                  @id @default(autoincrement())
  ulb_id            Int?
  usageType_id      Int
  subUsageType_name String
  multiply_factor   Int
  recStatus         Int                  @default(1)
  usageType         tbl_usageType_master @relation(fields: [usageType_id], references: [id])
}

model tbl_constructionAge_master {
  id                   Int    @id @default(autoincrement())
  ulb_id               Int?
  constructionAge_name String
  recStatus            Int    @default(1)
}

model tbl_wardRate_master {
  id                Int                         @id @default(autoincrement())
  wardArea_id       Int?               
  const_typeId      Int
  road_typeId       Int
  ward_rate         Float
  ward_id       Int?
  ulb_id            Int?
  ward_rate_yearly  Float?
  date_of_effect    DateTime                    @default("2025-04-01T00:00:00.000Z")
  recstatus         Int                         @default(1)
  construction_Type tbl_constructionType_master @relation(fields: [const_typeId], references: [id])
  roadType          tbl_roadType_master         @relation(fields: [road_typeId], references: [id])
  wardArea          tbl_wardArea_master?         @relation(fields: [wardArea_id], references: [id])
}

model tbl_wardArea_master {
  id                  Int                   @id @default(autoincrement())
  wardArea_name       String
  recStatus           Int                   @default(1)
  ulb_id              Int?
  ward_id             Int?
  tbl_wardRate_master   tbl_wardRate_master[]     
}

model tbl_ownerShipType_master {
  id             Int                 @id @default(autoincrement())
  ownerShip_name String
  ulb_id         Int?
  ownerDetails   tbl_owner_details[]
}

model tbl_floors_master {
  id         Int    @id @default(autoincrement())
  floor_name String
  ulb_id     Int?
  recstatus  Int    @default(1)
}

model tbl_owner_details {
  id             Int                      @id @default(autoincrement())
  ownerShip_id   Int
  ownerShip_name String?
  guardian_name  String?
  contact_no     Int
  PAN_no         String?
  Phone_no       String?
  Email_Address  String
  ulb_id         Int?
  ownerShip      tbl_ownerShipType_master @relation(fields: [ownerShip_id], references: [id])
}

model tbl_waterConnection_type {
  id           Int    @id @default(autoincrement())
  waterConType String
}

model tbl_fixed_waterTax {
  id       Int    @id @default(autoincrement())
  waterTax String
}

model tbl_constAge {
  id        Int    @id @default(autoincrement())
  const_Age String
  recstatus Int    @default(1)
}

model tbl_fy_year_list {
  pk_id         BigInt    @id @default(autoincrement())
  fyyearname    String?   @db.VarChar(50)
  fystartdate   DateTime? @db.Date
  fyenddate     DateTime? @db.Date
  entrydatetime DateTime? @default(now()) @db.Timestamp(6)
  entryby       BigInt?   @default(1)
  recstatus     Int?      @default(1) @db.SmallInt
}

model tbl_propertyDoc_master {
  id        Int    @id @default(autoincrement())
  doc_type  String
  is_mand   Int?
  recstatus Int    @default(1)
  order_no  Int?
}

model payment_master {
  id      Int   @id @default(autoincrement())
  name    String
}

model tbl_reconcile_remarks{
  id     Int    @id @default(autoincrement())
  name   String
}

model tbl_vacant_tax {
  id                Int      @id @default(autoincrement())
  ulb_id            Int
  calculationFactor String
  roadTypeId        Int
  rate              Float
  dateOfEffect      DateTime  @default("2025-04-01T00:00:00.000Z")
  recStatus         Int      @default(1)
}
