generator client {
  provider = "prisma-client-js"
 output   = "../../generated/inventory"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_NEOZY")

  schemas = ["inventory"]
}

// ======================================================
// PRODUCT CATEGORY
// ======================================================

model ProductCategory {
  id             BigInt   @id @default(autoincrement())
  companyId      Int
  name           String
  code           String?
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime? @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  products      Product[]
  subCategories ProductSubCategory[]

  @@map("product_categories")
  @@schema("inventory")
}

// ======================================================
// PRODUCT SUB CATEGORY
// ======================================================

model ProductSubCategory {
  id          BigInt   @id @default(autoincrement())
  companyId   Int
  categoryId  BigInt
  name        String
  description String?
  isActive       Boolean @default(true)
  createdAt DateTime? @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  categoryMaster ProductCategory @relation(fields: [categoryId], references: [id])
  products       Product[]

  @@index([companyId])
  @@index([categoryId])
  @@map("product_sub_categories")
  @@schema("inventory")
}

// ======================================================
// PRODUCT
// ======================================================

model Product {
  id                BigInt   @id @default(autoincrement())
  companyId         Int
  name              String
  price             Decimal?
  categoryId        BigInt?
  subCategoryId     BigInt?
  cost              Decimal?
  description       String?
  discount          Decimal?
  hsn               String?
  lowStockThreshold Decimal?
  mrp               Decimal?
  photos            Json?
  searchName        String?
  sku               String?
  specs             Json?
  status            String?
  tax               Decimal?
  trackingType      String?
  unit              String?
  isActive       Boolean @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  categoryMaster    ProductCategory?    @relation(fields: [categoryId], references: [id])
  subCategoryMaster ProductSubCategory? @relation(fields: [subCategoryId], references: [id])

  stocks       Stock[]
  stockLedgers StockLedger[]

  @@index([companyId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([sku])
  @@map("products")
  @@schema("inventory")
}

// ======================================================
// WAREHOUSE
// ======================================================

model Warehouse {
  id                   BigInt   @id @default(autoincrement())
  companyId            Int
  name                 String
  status               String?
  address              String?
  capacity             Decimal?
  city                 String?
  code                 String?
  demoSeedId           String?
  geofenceRadiusMeters Decimal?
  isDemo               Boolean? @default(false)
  latitude             Decimal?
  longitude            Decimal?
  managerName          String?
  managerPhone         String?
  notes                String?
  pincode              String?
  searchName           String?
  state                String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  stocks       Stock[]
  stockLedgers StockLedger[]
  dispatches   Dispatch[]

  @@index([companyId])
  @@index([code])
  @@map("warehouses")
  @@schema("inventory")
}

// ======================================================
// STOCK
// ======================================================

model Stock {
  id           BigInt   @id @default(autoincrement())
  companyId    Int
  availableQty Decimal
  productId    BigInt
  reservedQty  Decimal
  warehouseId  BigInt

  demoSeedId   String?
  isDemo       Boolean? @default(false)
  onHandQty    Decimal?
  reorderLevel Decimal?
  stockId      String?
  unit         String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  product        Product   @relation(fields: [productId], references: [id])

  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
  @@schema("inventory")
}

// ======================================================
// STOCK LEDGER
// ======================================================

model StockLedger {
  id        BigInt   @id @default(autoincrement())
  companyId Int

  afterQty   Decimal
  beforeQty  Decimal
  movementAt DateTime

  productId     BigInt
  qty           Decimal
  transactionId String
  type          String

  warehouseId BigInt

  balanceAfter  Decimal?
  date          String?
  demoSeedId    String?
  direction     String?
  isDemo        Boolean? @default(false)
  ledgerId      String?
  movementType  String?
  notes         String?
  product       String?
  referenceId   String?
  referenceType String?
  sourceId      String?
  sourceType    String?
  unit          String?
  warehouse     String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  productMaster  Product   @relation(fields: [productId], references: [id])

  warehouseMaster Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@index([transactionId])
  @@index([movementAt])
  @@map("stock_ledger")
  @@schema("inventory")
}

// ======================================================
// DISPATCH
// ======================================================

model Dispatch {
  id          BigInt   @id @default(autoincrement())
  companyId   Int
  status      String
  warehouseId BigInt

  approvalStatus         String?
  cancellationOrderId    String?
  cancellationReason     String?
  closedAt               DateTime?
  closedBy               String?
  customer               String?
  customerId             String?
  date                   String?
  deliveredAt            DateTime?
  deliveredBy            String?
  deliveryConfirmed      Boolean?
  deliveryDate           String?
  deliveryOTPExpiresAt   DateTime?
  deliveryOTPGeneratedAt DateTime?
  deliveryOTPHash        String?

  demoSeedId String?
  isDemo     Boolean? @default(false)

  dispatchDate   String?
  dispatchedAt   DateTime?
  dispatchId     String?
  dispatchNumber String?

  driverName  String?
  driverPhone String?

  items Json?

  lrNumber String?
  notes    String?
  orderId  String?

  paymentReconciliationPending Boolean?

  projectId   String?
  projectName String?

  returnedAt    DateTime?
  transporterId String?
  vehicleNo     String?
  verifiedBy    String?

  warehouse String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  isDeleted Boolean?  @default(false)
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  warehouseMaster              Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@index([dispatchNumber])
  @@map("dispatch")
  @@schema("inventory")
}
