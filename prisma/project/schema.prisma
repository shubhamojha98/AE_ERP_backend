generator client {
  provider = "prisma-client-js"
  output   = "../../generated/project"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PROJECT")

  schemas = ["project"]
}

enum ProjectStage {
  QUOTATION
  SURVEY
  SERVICE
  HANDOVER
  SUBSIDY
  NET_METERING

  @@schema("project")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED

  @@schema("project")
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum EngineeringStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("project")
}

model Customer {
  id           Int    @id @default(autoincrement())
  customerCode String @unique

  customerName  String
  customerPhone String  @unique
  customerEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recStatus Int      @default(1)

  projects Project[]

  @@index([customerName])
  @@index([customerPhone])
  @@schema("project")
}

model Project {
  id          Int      @id @default(autoincrement())
  projectCode String   @unique
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])

  leadId         String?
  capacityKw     Decimal       @db.Decimal(10, 2)
  projectType    String
  stage          ProjectStage  @default(QUOTATION)
  status         ProjectStatus @default(ACTIVE)
  salesOwnerId   Int?
  salesOwnerName String?
  surveyorId     Int?
  surveyorName   String?
  installerId    Int?
  installerName  String?
  managerId      Int?
  managerName    String?
  addressLine1   String?
  addressLine2   String?
  landmark       String?
  city           String?
  district       String?
  state          String?
  pincode        String?
  country        String        @default("India")
  notes          String?
  groupId        String?
  createdById    Int
  updatedById    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  recStatus      Int           @default(1)

  surveys Survey[]

  @@index([customerId])
  @@index([stage])
  @@index([status])
  @@index([salesOwnerId])
  @@index([surveyorId])
  @@index([installerId])
  @@index([managerId])
  @@index([createdAt])
  @@schema("project")
}

model Survey {
  id        Int     @id @default(autoincrement())
  surveyId  String  @unique
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  scheduledDate DateTime?
  surveyorId    Int?
  status        SurveyStatus @default(PENDING)
  notes         String?

  // Engineering can be added later
  engineering EngineeringDesign?

  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recStatus Int      @default(1)

  @@index([projectId])
  @@index([status])
  @@schema("project")
}

model EngineeringDesign {
  id         Int               @id @default(autoincrement())
  designId   String            @unique
  // Engineering belongs to a Survey
  surveyId   Int               @unique
  // Keep projectId if you frequently query engineering by project
  //   projectId Int
  capacityKw Decimal?          @db.Decimal(10, 2)
  designerId Int?
  status     EngineeringStatus @default(PENDING)

  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recStatus Int      @default(1)

  survey Survey @relation(fields: [surveyId], references: [id])
  //    project   Project @relation(fields: [projectId], references: [id])

  @@index([surveyId])
  //   @@index([projectId])
  @@index([status])
  @@schema("project")
}
